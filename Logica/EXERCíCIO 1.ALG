Algoritmo "exercício 1"
// Disciplina   : Linguagem de Lógica de programação
// Professor   : Nicolas Daniel Euflauzino
// Descrição   : Programa que realiza a soma de dois números
// Autor(a)    : Miguel Cesario
// Data atual  : 20/08/2026
Var
// Seção de Declarações das variáveis 
       numero1: real
       numero2: real
       resultado: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
   Escreval("Olá! digite o primeiro numero para executar a soma:")
   Leia(numero1)
   Escreval("digite o segundo numero")
   Leia(numero2)
   resultado <- numero1 + numero2
   Escreval("o resultado é:", resultado)
Fimalgoritmo